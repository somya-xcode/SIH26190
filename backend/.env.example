# ─────────────────────────────────────────────────────────────────────────────
# DocGuard Backend - Environment Variables Template
# Copy this file to .env and fill in real values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
SECRET_KEY=CHANGE_ME_REPLACE_WITH_64_CHAR_RANDOM_HEX
FRONTEND_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://docguard_user:your_db_password@localhost:5432/docguard_db

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=CHANGE_ME_REPLACE_WITH_64_CHAR_RANDOM_HEX_FOR_JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AES-256 Document Encryption (openssl rand -hex 32)
AES_MASTER_KEY=CHANGE_ME_REPLACE_WITH_64_CHAR_HEX_KEY

# File Storage
UPLOAD_DIR=./uploads/documents
MAX_FILE_SIZE_MB=50

# SMS Gateway (Fast2SMS / Twilio)
SMS_PROVIDER=fast2sms
SMS_API_KEY=CHANGE_ME_YOUR_SMS_API_KEY
SMS_SENDER_ID=DOCGRD
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# OTP Settings
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT_WINDOW_SECONDS=900
OTP_RATE_LIMIT_MAX_REQUESTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# Blockchain
BLOCKCHAIN_ENABLED=false
WEB3_PROVIDER_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
BLOCKCHAIN_PRIVATE_KEY=CHANGE_ME_YOUR_ECDSA_PRIVATE_KEY
BLOCKCHAIN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
BLOCKCHAIN_CHAIN_ID=11155111

# Logging
LOG_LEVEL=INFO
